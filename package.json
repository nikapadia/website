{
	"name": "@nikapadia/nikapadia.com",
	"version": "1.0.1",
	"author": "Nilay Kapadia",
	"license": "MIT",
	"description": "My personal website",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build --outDir build && type NUL > build/.nojekyll",
		"preview": "vite preview --outDir build",
		"check": "vite build",
		"check:watch": "vite build --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"deploy": "echo nikapadia.com > build/CNAME && gh-pages -d build -t true"
	},
	"devDependencies": {
		"eslint": "^8.40.0",
		"eslint-config-prettier": "^8.8.0",
		"prettier": "^2.8.8",
		"vite": "^4.3.5"
	},
	"type": "module",
	"dependencies": {
		"gh-pages": "^5.0.0"
	}
}
